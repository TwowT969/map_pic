# ============================================================
# APK 打包用后端地址（复制本文件为 .env.production.local 再改）
# ------------------------------------------------------------
# 1) cp .env.production.example .env.production.local
# 2) 把下面 <PC局域网IP> 换成运行后端的那台 PC 的局域网 IPv4
#    （手机要与该 PC 同一 Wi-Fi；PC 上 Windows 防火墙需放行入站 48081）
# 3) npm run cap:sync  ->  npm run build 会自动读取 .env.production.local
#
# 注意：
#  - npm run dev 不读此文件，浏览器开发仍走 /api Vite proxy，不受影响。
#  - .env.production.local 已被 .gitignore 忽略，勿提交真实 IP。
#  - 仅 VITE_ 前缀的变量会暴露给前端代码。
# ============================================================
VITE_API_BASE=http://<PC局域网IP>:48081/api
