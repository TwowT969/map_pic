{
  "appId": "com.mapalbum.app",
  "appName": "地图相册",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "*.amap.com",
      "*.alicdn.com",
      "*.aliyuncs.com"
    ],
    "hostname": "mapalbum.app",
    "androidUserAgent": "Mozilla/5.0 MapAlbumApp"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "ios": {
    "contentInset": "automatic",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "Camera": {
      "saveToGallery": false
    },
    "Geolocation": {
      "permissions": [
        "location"
      ]
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark"
    }
  }
}
